# ============================================================
# enterprise-rag-chatglm 环境变量示例
# 复制为 .env 并填入真实密钥；.env 不进版本控制
# main.py 顶部需执行 load_dotenv() 使其生效
# ============================================================

# ── 应用与 HTTP ──
APP_NAME=enterprise-rag-chatglm
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Chat 模型 ──
MODEL_CHAT_PROVIDER=zhipu
MODEL_CHAT_MODEL_NAME=glm-5.2
MODEL_CHAT_API_KEY=replace-with-secret
MODEL_CHAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MODEL_CHAT_TEMPERATURE=0.2
MODEL_CHAT_MAX_TOKENS=2048
MODEL_CHAT_TIMEOUT_SECONDS=45
MODEL_CHAT_MAX_RETRIES=2

# ── Embedding 模型 ──
MODEL_EMBED_MODEL_NAME=BAAI/bge-small-zh-v1.5
MODEL_EMBED_DEVICE=cpu
MODEL_EMBED_BATCH_SIZE=32
MODEL_EMBED_NORMALIZE=true

# ── 检索与重排 ──
RETRIEVAL_TOP_K=8
RETRIEVAL_FETCH_MULTIPLIER=3
RETRIEVAL_PER_QUERY_TOP_K=20
RETRIEVAL_VECTOR_STORE_TYPE=chromadb
RETRIEVAL_VECTOR_STORE_COLLECTION=enterprise_knowledge
RETRIEVAL_VECTOR_STORE_PERSIST_DIRECTORY=./data/index
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RETRIEVAL_RERANK_TOP_K=4
RETRIEVAL_RERANK_MIN_SCORE=0.05

# ── Agent 与护栏 ──
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_ALLOWED_TOOLS=retrieve_knowledge,list_sources,summarize_citations
AGENT_REVIEW_ENABLED=true
AGENT_REVIEW_USE_LLM=false
AGENT_REVIEW_MAX_RETRIES=1
AGENT_REVIEW_MAX_EVIDENCE_CHARS=6000

SECURITY_MAX_QUESTION_LENGTH=2000
SECURITY_MAX_ANSWER_LENGTH=8000
SECURITY_MAX_HISTORY_MESSAGES=12
SECURITY_PROMPT_INJECTION_ACTION=reject
