# ── Python 字节码 ──────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# ── 分发 / 打包 ───────────────────────────────────────────
.Python
build/
dist/
*.egg-info/
*.egg

# ── 虚拟环境 ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── IDE ───────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── 测试 /  lint / 覆盖率 ─────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── 数据与索引（保留目录结构，忽略内容）──────────────────
# 模型权重与向量索引体积大，禁止提交；超 100MB 会被 GitHub 拒绝
data/index/**
!data/index/.gitkeep
data/raw/**
!data/raw/.gitkeep

!config/.env.example

# 向量库落盘文件
*.db
*.sqlite3
*.sqlite

# 本地模型权重
models/
*.bin
*.safetensors
*.gguf
*.onnx
*.pt
*.pth

# 嵌入与 HuggingFace 缓存
.model_cache/
.huggingface/
.cache/

# ── 日志与运行时 ──────────────────────────────────────────
logs/
*.log
pids/
*.pid
run/

# ── 密钥与敏感文件 ────────────────────────────────────────
# 禁止提交 API Key、私钥、令牌
.env
.env/
.env.local
.env.*.local
!.env.example
config/.env
config/.env.local
config/.env.*.local
config/*.local.yaml
config/*.generated.*
*.key
*.pem
*.crt
id_rsa*
id_ed25519*

# ── Jupyter ───────────────────────────────────────────────
.ipynb_checkpoints/

# ── 备份与临时 ────────────────────────────────────────────
*.bak
*.orig
*.rej
*.tmp
src/abandon/

