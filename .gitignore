# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing / linting caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# OS
.DS_Store
Thumbs.db

# Local data — 保留目录结构，忽略实际数据
data/index/*
!data/index/.gitkeep
data/raw/*
!data/raw/.gitkeep

# Local secrets — 禁止提交 API Key 等敏感文件
# 允许提交模板文件 .env.example
.env
.env.local
.env.*.local
!.env.example
config/.env
config/.env.local
config/.env.*.local
